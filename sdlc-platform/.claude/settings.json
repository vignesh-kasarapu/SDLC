{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python tools/*)",
      "Bash(python -m pytest tools/tests*)",
      "Bash(git -C projects/*)",
      "Bash(git init projects/*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Bash(git push*)",
      "Bash(docker push*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/lock_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
