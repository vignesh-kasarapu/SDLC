{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed FRD changes, reviewed by a human BEFORE the next FRD version is written",
  "type": "object",
  "required": ["from_version", "target_version", "changes"],
  "properties": {
    "from_version": {"type": "integer", "minimum": 1},
    "target_version": {"type": "integer", "minimum": 2},
    "inputs": {"type": "array", "items": {"type": "string"}, "description": "Files the proposal is based on"},
    "changes": {"type": "array", "minItems": 1, "items": {"type": "object",
      "required": ["id", "action", "summary", "reason", "triggered_by", "decision"],
      "properties": {
        "id": {"type": "string", "pattern": "^CH-\\d{3}$"},
        "action": {"enum": ["add", "modify", "remove", "split", "tag", "add_question", "resolve_question", "section"],
          "description": "add/modify/remove/split a requirement, tag checklist refs, add or resolve an open question, or edit a non-requirement FRD section"},
        "requirement_ids": {"type": "array", "items": {"type": "string"}},
        "summary": {"type": "string", "description": "One line, plain language"},
        "before": {"type": "string", "description": "Current text (empty for add)"},
        "after": {"type": "string", "description": "Proposed text"},
        "reason": {"type": "string"},
        "triggered_by": {"type": "array", "minItems": 1, "items": {"type": "string",
          "pattern": "^(E-\\d{3}|REVIEW-\\d+|SUG-\\d{3}|Q-\\d{3}|[A-Z]{2,4}-[A-Z0-9-]+|USER-STACK)$"},
          "description": "Evaluator issue, reviewer feedback, recommendation, open question, or checklist item"},
        "severity": {"enum": ["blocker", "major", "minor", "feedback"],
          "description": "How serious the triggering problem is; blocker changes are usually needed for the gate to pass"},
        "options": {"type": "array", "items": {"type": "string"},
          "description": "Alternative wordings or values the user can choose between (e.g. two policy options)"},
        "decision": {"enum": ["pending", "approved", "rejected", "edited"]},
        "chosen_option": {"type": "string"},
        "user_note": {"type": "string", "description": "User's instruction; required when decision=edited"},
        "decided_by": {"type": "string"},
        "decided_at": {"type": "string"}}}}
  }
}
