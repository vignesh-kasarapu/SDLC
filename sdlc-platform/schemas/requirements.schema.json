{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Requirements set (used by requirements.json and frd.vN.json)",
  "type": "object",
  "required": ["requirements", "open_questions"],
  "properties": {
    "version": {"type": "integer", "minimum": 0},
    "requirements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/req"}},
    "change_log": {"type": "array", "description": "Revisions only: which approved change-plan items this version applied",
      "items": {"type": "object", "required": ["change_id", "applied"], "properties": {
        "change_id": {"type": "string", "pattern": "^CH-\\d{3}$"},
        "applied": {"type": "boolean"},
        "requirement_ids": {"type": "array", "items": {"type": "string"}},
        "note": {"type": "string"}}}},
    "non_requirement_blocks": {"type": "array", "items": {"type": "string", "pattern": "^C-\\d{3,}$"},
      "description": "CRD blocks deliberately not turned into requirements (titles, background, boilerplate)"},
    "open_questions": {"type": "array", "items": {"type": "object", "required": ["id", "question", "blocking"],
      "properties": {"id": {"type": "string", "pattern": "^Q-\\d{3}$"}, "question": {"type": "string"},
        "source": {"type": "array", "items": {"type": "string"}},
        "related": {"type": "array", "items": {"type": "string"}},
        "blocking": {"type": "boolean"},
        "resolution": {"type": "string"}}}}
  },
  "$defs": {
    "req": {
      "type": "object",
      "required": ["id", "type", "title", "statement", "priority", "source", "acceptance_criteria", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^(FR|NFR|BR|DR|IR|SR)-\\d{3}$"},
        "type": {"enum": ["functional", "non_functional", "business_rule", "data", "integration", "security"]},
        "title": {"type": "string", "minLength": 3},
        "statement": {"type": "string", "minLength": 10},
        "priority": {"enum": ["must", "should", "could", "wont"]},
        "source": {"type": "array", "minItems": 1,
          "items": {"type": "string", "pattern": "^(C-\\d{3,}|REVIEW-\\d+|CHECKLIST-[A-Z0-9-]+|USER-STACK|SUG-\\d{3})$"},
          "description": "CRD paragraph IDs (C-nnn); REVIEW-n for reviewer feedback; CHECKLIST-<item> for domain-recommended additions, which must have status=assumed; USER-STACK for technical constraints decided by the user in 01-frd/tech-stack.json"},
        "acceptance_criteria": {"type": "array", "items": {"type": "string"}},
        "status": {"enum": ["confirmed", "needs_clarification", "assumed"]},
        "checklist_refs": {"type": "array", "items": {"type": "string"}},
        "client_ref": {"type": "string", "description": "The client's own ID for this requirement (intake mode), e.g. REC-004"},
        "clarification": {"type": "string", "description": "Intake mode: the platform's interpretation or the client's answer; the statement itself stays the client's wording"},
        "roles": {"type": "array", "items": {"type": "string"}},
        "notes": {"type": "string"}
      }
    }
  }
}
