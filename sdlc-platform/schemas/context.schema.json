{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Business context",
  "type": "object",
  "required": ["overview", "objectives", "stakeholders", "roles", "scope"],
  "properties": {
    "overview": {"type": "string"},
    "objectives": {"type": "array", "items": {"type": "object", "required": ["id", "text", "source"],
      "properties": {"id": {"type": "string", "pattern": "^OBJ-\\d{3}$"}, "text": {"type": "string"},
        "source": {"type": "array", "items": {"type": "string", "pattern": "^C-\\d{3,}$"}}}}},
    "stakeholders": {"type": "array", "items": {"type": "object", "required": ["name", "interest"],
      "properties": {"name": {"type": "string"}, "interest": {"type": "string"}}}},
    "roles": {"type": "array", "items": {"type": "object", "required": ["name", "description"],
      "properties": {"name": {"type": "string"}, "description": {"type": "string"},
        "source": {"type": "array", "items": {"type": "string"}}}}},
    "scope": {"type": "object", "required": ["in", "out"], "properties": {
      "in": {"type": "array", "items": {"type": "string"}}, "out": {"type": "array", "items": {"type": "string"}}}},
    "operating_context": {"type": "string"},
    "integrations": {"type": "array", "items": {"type": "string"}},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "assumptions": {"type": "array", "items": {"type": "string"}}
  }
}
